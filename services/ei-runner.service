[Unit]
Description=Edge Impulse Linux Runner
After=network.target sound.target

[Service]
User=msenese
ExecStartPre=/bin/sh -c 'grep -q wm8960soundcard /proc/asound/cards || (echo "ei-runner: wm8960 sound card not found in /proc/asound/cards" >&2; exit 1)'
# Self-heals --monitor's local cache after a crash or hard power-cycle --
# see docs/model-monitoring-corruption.md and
# services/ei-runner-cache-cleanup.sh for the full story. Without this,
# a single zero-byte cache file left by an interrupted write makes the
# runner crash-loop forever on startup.
ExecStartPre=/home/msenese/services/ei-runner-cache-cleanup.sh
# edge-impulse-linux-runner rejects named ALSA addressing outright (confirmed
# live: "cannot find microphones with that name" for --microphone
# hw:wm8960soundcard,0) -- it only accepts numeric hw:N,0 matching its own
# enumeration. Card *numbers* aren't stable across reboots (load order can
# shift them), so resolve the current number for this card id right before
# starting, rather than hardcoding hw:1,0 -- same technique as
# dashboard/app.py's _build_ei_runner_unit().
# --monitor enables Edge Impulse's Model Monitoring (continuous local
# inference + periodic summary upload to Studio) -- confirmed live this
# runner version/target supports it. Verified NOT to survive the card
# rebuild the first time because it was only ever applied live, never
# committed here -- don't repeat that.
#
# --monitor needs to authenticate to upload summaries; without --api-key it
# tries an INTERACTIVE login prompt, which can't work under systemd (no
# TTY) -- it exits immediately and restart-loops forever. Replace
# YOUR_EI_API_KEY_HERE below with the real key from config.py before
# installing this file (this static template is only used for initial
# manual setup -- the dashboard's own _build_ei_runner_unit() in
# dashboard/app.py fills this in automatically from cfg.EI_API_KEY whenever
# it regenerates the live unit, e.g. on a Classic/Buffer mode switch).
ExecStart=/bin/sh -c 'CARD=$(grep -oP "^\s*\K[0-9]+(?=.*\[wm8960soundcard)" /proc/asound/cards); exec /usr/bin/edge-impulse-linux-runner --microphone "hw:$CARD,0" --model-file /home/msenese/sonos-model.eim --disable-camera --monitor --api-key YOUR_EI_API_KEY_HERE'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

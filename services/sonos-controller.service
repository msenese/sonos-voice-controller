[Unit]
Description=Sonos Voice Controller
After=network.target ei-runner.service
# No Requires=ei-runner.service -- After= alone keeps ei-runner starting
# first on boot, without hard-tying this service's lifecycle to it (e.g. an
# ei-runner restart shouldn't cascade-stop this one too).

[Service]
ExecStart=/usr/bin/python3 -u /home/msenese/sonos-controller.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
